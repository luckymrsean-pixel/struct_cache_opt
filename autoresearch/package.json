{
  "name": "autoresearch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build":        "tsc --noEmit",
    "start":        "tsx src/index.ts",
    "test:term":    "tsx scripts/test-term.ts",
    "test:log":     "tsx scripts/test-log.ts",
    "test:errors":  "tsx scripts/test-errors.ts",
    "test:pty":     "tsx scripts/test-interactive-pty.ts",
    "test":         "bash scripts/run-all-tests.sh"
  },
  "dependencies": {
    "node-pty": "^1.0.0",
    "ws":       "^8.17.0",
    "yaml":     "^2.4.0"
  },
  "devDependencies": {
    "tsx":          "^4.7.0",
    "typescript":   "^5.4.0",
    "@types/node":  "^20.0.0",
    "@types/ws":    "^8.5.10"
  }
}
